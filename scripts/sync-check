#!/bin/sh
# Shows whether this checkout is clean and in sync with origin/main.
# Exit 0 only for a clean main equal to origin/main. --no-fetch skips the network.
set -eu
cd "$(git rev-parse --show-toplevel)"
[ "${1:-}" = "--no-fetch" ] || git fetch -q origin main

branch=$(git branch --show-current)
dirty=$(git status --porcelain)
counts=$(git rev-list --left-right --count HEAD...origin/main)
ahead=${counts%%[[:space:]]*}
behind=${counts##*[[:space:]]}

echo "branch: ${branch:-detached} · ahead: $ahead · behind: $behind"
[ -z "$dirty" ] || { echo "uncommitted changes:"; printf '%s\n' "$dirty"; }

if [ "$branch" = main ] && [ -z "$dirty" ] && [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then
  echo "ok: clean main, equal to origin/main"
  exit 0
fi
echo "not in sync: see CONTRIBUTING.md, «Синхронизация»"
exit 1
