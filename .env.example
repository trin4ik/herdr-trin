# Optional host directory overrides. Paths only; never put access tokens here.
# Defaults use your current HOME. Do not mount your entire home into a container.
# CODEX_DIR=/absolute/path/to/.codex
# CLAUDE_DIR=/absolute/path/to/.claude
# QUOTA_BRIDGE_DIR=/absolute/path/to/.local/state/quota-hub/bridge
# QUOTA_CONFIG=./quota-hub/configs/docker.json
