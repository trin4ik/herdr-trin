# Default deny at the root: personal instructions, research, screenshots stay local.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/THIRD_PARTY.md
!/compose.yaml
!/docs/
!/scripts/
!/layout/
!/quota-hub/

/layout/*
!/layout/trin/
/layout/trin/*
!/layout/trin/README.md
!/layout/trin/AGENTS.md
!/layout/trin/keys.json
!/layout/trin/layouts/
!/layout/trin/mods/
!/layout/trin/tests/
/layout/trin/mods/*
!/layout/trin/mods/trin-agents/
!/layout/trin/mods/trin-brand/
!/layout/trin/mods/trin-projects/
!/layout/trin/mods/trin-tab-menu/
!/layout/trin/mods/trin-tabs/
!/layout/trin/mods/trin-quotas/
!/layout/trin/mods/trin-spaces/

**/gpui-kit.d.ts
**/jsconfig.json
**/__pycache__/
**/*.pyc
**/*.error
**/.DS_Store
**/.env
**/.env.*
!/.env.example
**/*.local.*
**/node_modules/
**/data/
**/credentials/
**/auth.json
**/service.json
**/*.pem
**/*.key
**/*.sqlite*
**/*.db
**/*.log
**/dist/
**/bin/

# Personal instructions and journal stay here, but are never published.
/AGENTS.md
/CHANGELOG.md
/quota-hub/tools/opencode-bridge/README.local.md
